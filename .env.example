# Public site URL used for canonical, sitemap, and social preview origins.
VITE_SITE_URL="https://serendibtrading.lk"
# Optional server-side override used by /api/og and /api/sitemap.
SITE_URL="https://serendibtrading.lk"

# Neon Postgres — the only database (inventory, leads, traffic).
# NOTE: A real connection string was previously committed here. It has been
# rotated out. Create a fresh Neon password in the dashboard and set DATABASE_URL
# in Vercel only — never commit a real credential to this file.
DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Supabase Storage only (vehicle photos). Not a second Postgres.
# Public listing URLs look like: {SUPABASE_URL}/storage/v1/object/public/vehicle-images/...
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Google OAuth Credentials for Vercel Serverless Admin Login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated Google emails allowed to use /admin.
# If unset, the built-in allowlist in api/auth/_session.js is used.
ALLOWED_ADMIN_EMAILS=""

# Secret key used for signing JWT session cookies (at least 32 characters)
AUTH_SECRET=""

# Server-only Vercel Function secret for /api/leads rate limiting
LEAD_RATE_LIMIT_SALT=""

# Optional Image CDN Base URL (e.g. Cloudflare R2 / Custom CDN domain)
VITE_IMAGE_CDN_BASE_URL=""

# Optional image transform behaviour (e.g. Supabase image transform toggle)
VITE_SUPABASE_IMAGE_TRANSFORM=""

# Enable Supabase page-view / car-view analytics (set to "true" to enable)
VITE_ENABLE_SUPABASE_ANALYTICS=""

# Legacy Supabase client URLs (stubbed — Neon is system of record, Supabase is Storage only)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY=""
