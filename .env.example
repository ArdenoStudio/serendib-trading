# Public site URL used for canonical, sitemap, and social preview origins.
VITE_SITE_URL="https://serendib-trading.vercel.app"
# Optional server-side override used by /api/og and /api/sitemap.
SITE_URL="https://serendib-trading.vercel.app"

# Supabase (optional for local demo).
# Leave BOTH empty for static demo inventory from src/data/cars.json.
# Example values below point at the live project — only set them when you
# intentionally want local to talk to that backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Vercel Function secrets for /api/leads. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
LEAD_RATE_LIMIT_SALT=

# Disabled by default because direct public Supabase RPC analytics are easy to abuse.
# Prefer Vercel Analytics or a server/Edge Function endpoint for public traffic.
VITE_ENABLE_SUPABASE_ANALYTICS="false"

# Only enable if Supabase Image Transformations are turned on for this project.
# When false (default), vehicle images use the public object URL so cards never 403.
VITE_SUPABASE_IMAGE_TRANSFORM="false"
