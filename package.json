{
  "name": "serendib-trading",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/prerender.mjs",
    "build:app": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:e2e": "npm run build:app && playwright test",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "render:teaser": "remotion render src/remotion/index.ts SerendibTeaser renders/serendib-teaser.mp4 --codec=h264 --pixel-format=yuv420p",
    "render:showcase": "remotion render src/remotion/index.ts SerendibWebsiteShowcase renders/serendib-website-showcase.mp4 --codec=h264 --pixel-format=yuv420p",
    "render:videos": "npm run render:teaser && npm run render:showcase"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@thesvg/react": "^3.0.10",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "framer-motion": "^12.38.0",
    "jose": "^6.1.0",
    "lenis": "^1.3.20",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@remotion/cli": "^4.0.464",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "remotion": "^4.0.464",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "ws": "^8.21.0",
    "esbuild": "^0.28.1"
  }
}
